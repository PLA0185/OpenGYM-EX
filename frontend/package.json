{
  "name": "opengym-frontend",
  "private": true,
  "version": "2.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "VITE_MOBILE=1 VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/ VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/ vite build && cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:local": "node scripts/build-local.mjs",
    "build:android": "node scripts/build-local.mjs --android",
    "build:windows": "node scripts/build-local.mjs && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "data:bootstrap": "node ../scripts/data/bootstrap.mjs",
    "data:build": "python -X utf8 ../scripts/data/build-seed.py && python -X utf8 ../scripts/data/build-media.py && python -X utf8 ../scripts/data/build-references.py && python -X utf8 ../scripts/data/build-hq-media.py"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/app": "7.1.2",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capgo/capacitor-health": "^7.2.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "main": "desktop/main.cjs",
  "description": "OpenGym EX personal training and nutrition app",
  "author": "Xunlian contributors / openGym contributors",
  "build": {
    "appId": "app.xunlian.personal",
    "productName": "OpenGymEX",
    "directories": {
      "output": "../artifacts/windows"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE-AGPL.txt"
      },
      {
        "from": "../NOTICE.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "OpenGymEX-${version}-portable.exe",
      "useZip": true
    }
  }
}
